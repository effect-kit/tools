{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "prepare": "lefthook install && node scripts/setup-agents.mjs && effect-tsgo patch",
    "clean": "node scripts/clean.mjs",
    "codegen": "pnpm --recursive --parallel --filter \"./packages/*\" run codegen",
    "build": "tsc -b tsconfig.packages.json && pnpm --recursive --parallel --filter \"./packages/*\" run build",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "check": "effect-tsgo tsrs -b tsconfig.json",
    "check-tsc": "tsc -b tsconfig.json",
    "check-dist-types": "node scripts/check-dist-types.mjs",
    "lint": "oxlint -f unix && dprint check",
    "lint-fix": "oxlint --fix && dprint fmt",
    "changeset": "changeset",
    "changeset-version": "changeset version && pnpm install --lockfile-only --ignore-scripts && dprint fmt",
    "ci:check": "pnpm lint && pnpm circular && pnpm check-tsc && vitest run && pnpm build && pnpm check-dist-types",
    "release:version": "pnpm changeset-version",
    "release:prepare": "pnpm ci:check",
    "release:pack": "changeset pack --out-dir tmp/release",
    "release:check": "node scripts/release/bin.ts check",
    "release:smoke": "node scripts/release/bin.ts smoke"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.3",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@effect-kit/oxc": "workspace:^",
    "@effect/tsgo": "0.73.2",
    "@effect/vitest": "4.1.5",
    "@types/node": "26.6.6",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "dprint": "0.65.0",
    "effect": "4.1.5",
    "glob": "14.0.6",
    "lefthook": "2.2.2",
    "madge": "8.0.0",
    "oxlint": "1.94.0",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
