{
  "name": "@effect-kit/jsdocs",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Checks TSDoc against Effect's conventions and writes a JSON model of every API (unofficial fork of Effect's internal @effect/jsdocs)",
  "homepage": "https://github.com/effect-kit/tools/tree/main/packages/jsdocs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effect-kit/tools.git",
    "directory": "packages/jsdocs"
  },
  "bugs": {
    "url": "https://github.com/effect-kit/tools/issues"
  },
  "keywords": [
    "effect",
    "jsdoc",
    "tsdoc",
    "documentation",
    "typescript"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "bin": {
    "effect-kit-jsdocs": "./src/bin.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/Jsdocs.ts",
    "./*": "./src/*.ts",
    "./bin": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "NOTICE.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "bin": {
      "effect-kit-jsdocs": "./dist/bin.js"
    },
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/Jsdocs.js",
      "./*": "./dist/*.js",
      "./bin": null
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "effect": "^4.1.5",
    "glob": "^14.0.6",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.5",
    "@types/node": "26.6.6"
  }
}
