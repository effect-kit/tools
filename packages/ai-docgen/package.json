{
  "name": "@effect-kit/ai-docgen",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Builds an LLMS.md from a directory of runnable TypeScript docs (unofficial fork of Effect's internal @effect/ai-docgen)",
  "homepage": "https://github.com/effect-kit/tools/tree/main/packages/ai-docgen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effect-kit/tools.git",
    "directory": "packages/ai-docgen"
  },
  "bugs": {
    "url": "https://github.com/effect-kit/tools/issues"
  },
  "keywords": [
    "effect",
    "llms",
    "documentation",
    "ai",
    "typescript"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "bin": {
    "effect-kit-ai-docgen": "./src/main.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./main": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "NOTICE.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "bin": {
      "effect-kit-ai-docgen": "./dist/main.js"
    },
    "exports": {
      "./package.json": "./package.json",
      "./*": "./dist/*.js",
      "./main": null
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.5",
    "effect": "^4.1.5",
    "glob": "^14.0.6"
  },
  "devDependencies": {
    "@types/node": "26.6.6"
  }
}
