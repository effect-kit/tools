{
  "name": "@effect-kit/bundle",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Measures and compares the minified, gzipped bundle size of entry-point fixtures (unofficial fork of Effect's internal @effect/bundle)",
  "homepage": "https://github.com/effect-kit/tools/tree/main/packages/bundle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effect-kit/tools.git",
    "directory": "packages/bundle"
  },
  "bugs": {
    "url": "https://github.com/effect-kit/tools/issues"
  },
  "keywords": [
    "effect",
    "bundle-size",
    "rollup",
    "gzip",
    "typescript"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "bin": {
    "effect-kit-bundle": "./src/bin.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./bin": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "NOTICE.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "bin": {
      "effect-kit-bundle": "./dist/bin.js"
    },
    "exports": {
      "./package.json": "./package.json",
      "./*": "./dist/*.js",
      "./bin": null
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "effect": "^4.1.5",
    "glob": "^14.0.6",
    "rollup": "^4.68.3",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.5",
    "@types/node": "26.6.6"
  }
}
